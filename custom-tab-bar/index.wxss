/* 高度和原生 tabBar 一致（48px + 底部安全区），页面里贴底的元素不用跟着改 */
.tb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FDF7EA;
  box-shadow: 0 -1px 0 rgba(217, 122, 147, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  font-family: 'kuaile', 'Yuanti SC', 'YouYuan', '幼圆', 'PingFang SC', sans-serif;
}

.tb-inner {
  position: relative;
  display: flex;
  height: 48px;
}

/* 底块：宽度占一格，translateX 按格数走；回弹曲线让它停下时稍微晃一下 */
.tb-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 25%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.42s cubic-bezier(0.34, 1.4, 0.64, 1);
  pointer-events: none;
}

.tb-pill {
  width: 60px;
  height: 40px;
  border-radius: 20px;
  background: #FBE7EC;
}

.tb-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.tb-icon-wrap {
  position: relative;
  width: 22px;
  height: 22px;
  transition: transform 0.38s cubic-bezier(0.34, 1.8, 0.64, 1);
}

.tb-item.on .tb-icon-wrap {
  transform: translateY(-1px) scale(1.14);
}

/* 两张图叠在一起淡入淡出，颜色切换不会一闪 */
.tb-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 22px;
  height: 22px;
  transition: opacity 0.25s ease;
}

.tb-icon.on,
.tb-item.on .tb-icon.off {
  opacity: 0;
}

.tb-item.on .tb-icon.on {
  opacity: 1;
}

.tb-text {
  margin-top: 2px;
  font-size: 10px;
  line-height: 13px;
  color: #A38B6A;
  transition: color 0.25s ease;
}

.tb-item.on .tb-text {
  color: #D97A93;
  font-weight: 600;
}

/* 按下时轻轻缩一下 */
.tb-press .tb-icon-wrap {
  transform: scale(0.88);
}

.tb-badge {
  position: absolute;
  top: -5px;
  left: 14px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  box-sizing: border-box;
  border-radius: 8px;
  background: #EC8FA5;
  color: #fff;
  font-size: 10px;
  line-height: 16px;
  text-align: center;
  border: 1px solid #FDF7EA;
}
