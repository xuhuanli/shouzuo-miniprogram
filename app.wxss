/* 全局样式：小清新粉 + 莫兰迪浅紫点缀，深棕手写字体 */
@font-face {
  font-family: 'muyao';
  src: url('data:font/woff2;base64,') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'kuaile';
  src: url('data:font/woff2;base64,') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
page {
  /* 自定义底部导航（custom-tab-bar）盖在页面上，不会像原生导航那样把页面往上让；
     tab 页里贴底的条、页面底部留白都要加上这段高度 */
  --tabbar-h: calc(48px + env(safe-area-inset-bottom));
  --bg: #FBF3F4;
  --card: #FFFFFF;
  --ink: #5B4636;
  --sub: #A68B75;
  --line: #F2E0E3;
  --accent: #EC8FA5;
  --accent-deep: #D97A93;
  --accent-soft: #FBE7EC;
  --purple: #B5A1C6;
  --purple-deep: #8E7AA6;
  --purple-soft: #F0EAF5;
  background: var(--bg);
  color: var(--ink);
  font-size: 31rpx;
  line-height: 1.62;
  letter-spacing: 1rpx;
  font-family: 'kuaile', 'muyao', 'Yuanti SC', 'YouYuan', '幼圆', 'PingFang SC', sans-serif;
}

/* 手写体标题（沿用类名，全部页面通用） */
.serif {
  font-family: 'muyao', 'kuaile', 'Yuanti SC', 'YouYuan', '幼圆', sans-serif;
  letter-spacing: 3rpx;
}

.page-pad {
  padding: 24rpx 32rpx 60rpx;
}

/* 二级页面的返回统一交给微信自带的左上角箭头（‹），页面里不再放中文返回胶囊 */

.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(150, 100, 110, 0.08);
  overflow: hidden;
}

.section-title {
  display: flex;
  align-items: baseline;
  margin: 40rpx 0 24rpx;
}

.section-title .zh {
  font-size: 39rpx;
  font-weight: 600;
}

.section-title .en {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--purple);
  letter-spacing: 3rpx;
}

.chip {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--sub);
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.chip.on {
  color: #fff;
  background: var(--accent);
  border-color: var(--accent);
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 2.6;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.45;
  color: #fff;
  background: var(--accent);
}

.btn-ghost {
  background: transparent;
  color: var(--accent-deep);
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.btn-ghost::after {
  border: none;
}

.price {
  color: var(--accent-deep);
  font-weight: 700;
}

.empty {
  text-align: center;
  color: var(--sub);
  padding: 120rpx 0 60rpx;
  font-size: 28rpx;
}

.empty .icon {
  font-size: 78rpx;
  margin-bottom: 16rpx;
}
