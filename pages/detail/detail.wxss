.d-gallery {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
}

.d-swiper {
  width: 100%;
  height: 620rpx;
}

.d-img {
  width: 100%;
  height: 620rpx;
  display: block;
}

.d-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 99rpx;
  background: rgba(91, 70, 54, 0.42);
  color: #fff;
  font-size: 22rpx;
}

.d-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 26rpx;
}

.d-name {
  font-size: 44rpx;
  font-weight: 700;
}

.d-price {
  font-size: 39rpx;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--sub);
}

.d-priceline {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--sub);
  letter-spacing: 1rpx;
}

.d-block {
  margin-top: 24rpx;
  padding: 30rpx 32rpx;
}

.d-label {
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.d-desc {
  font-size: 28rpx;
  line-height: 1.7;
}

/* 「关于这件作品」里的尺寸小块 */
.d-size {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--accent-soft);
  border-radius: 16rpx;
  display: flex;
  align-items: baseline;
}

.d-size-k {
  font-size: 24rpx;
  color: var(--accent-deep);
  flex-shrink: 0;
  margin-right: 16rpx;
  letter-spacing: 2rpx;
}

.d-size-v {
  font-size: 27rpx;
  color: var(--ink);
  flex: 1;
}

/* 普通 / 缎面 切换（面料跟着这一档走） */
.fb-grades {
  display: flex;
  margin-bottom: 22rpx;
}

.fb-grade {
  flex: 1;
  margin-right: 16rpx;
  padding: 14rpx 8rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--line);
  background: #FDFAF8;
  text-align: center;
  line-height: 1.3;
}

.fb-grade:last-child {
  margin-right: 0;
}

.fb-grade-k {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.fb-grade-p {
  display: block;
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 2rpx;
}

.fb-grade.on {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.fb-grade.on .fb-grade-k,
.fb-grade.on .fb-grade-p {
  color: var(--accent-deep);
}

/* 表布 / 里布 两个框 */
.fb-box {
  margin-bottom: 22rpx;
}

.fb-box:last-child {
  margin-bottom: 0;
}

.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.fb-t {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--purple-deep);
}

.fb-hint {
  font-size: 22rpx;
  color: var(--sub);
}

.fb-scroll {
  width: 100%;
  white-space: nowrap;
  display: flex;
}

.fb-item {
  display: inline-block;
  width: 160rpx;
  margin-right: 18rpx;
  vertical-align: top;
}

.fb-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: block;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.fb-item.on .fb-img {
  border-color: var(--accent);
}

.fb-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sub);
  text-align: center;
  white-space: normal;
  line-height: 1.35;
}

.fb-item.on .fb-name {
  color: var(--accent-deep);
}

.fb-empty {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
  background: var(--bg);
  border-radius: 16rpx;
  border: 2rpx dashed var(--line);
}

.fb-fb {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--purple-deep);
}

.d-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(250, 247, 242, 0.96);
  border-top: 1rpx solid var(--line);
}

.bar-price {
  flex-shrink: 0;
  font-size: 36rpx;
}

/* 乘号：两根圆头短线交叉画出来，粗细、圆角能控，和旁边的加减号是一套 */
.bar-times {
  position: relative;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin: 0 18rpx;
}

.bar-times::before,
.bar-times::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -12rpx;
  border-radius: 2rpx;
  background: var(--purple);
}

.bar-times::before {
  transform: rotate(45deg);
}

.bar-times::after {
  transform: rotate(-45deg);
}

/* 数量：− 数字 ＋，数字不能手输，最少 1 */
.stepper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 6rpx;
  /* 和右边按钮的间距放在这里：button 的 margin 会被微信默认样式吃掉，靠不住 */
  margin-right: 32rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.st-btn {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

/* 加减号同样用短线画，粗细、颜色和乘号一套 */
.st-btn::before,
.st-btn::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -10rpx;
  border-radius: 2rpx;
  background: var(--accent-deep);
}

.st-btn.minus::after {
  display: none;
}

.st-btn.plus::after {
  transform: rotate(90deg);
}

.st-btn.disabled {
  opacity: 0.4;
}

.st-btn.disabled::before {
  background: var(--sub);
}

.st-press {
  transform: scale(0.86);
}

.st-num {
  min-width: 52rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

/* 一行要放 价格 × 数量 + 按钮，按钮收窄一点、字号小一号 */
.bar-btn {
  flex: 1;
  min-width: 0;
  /* 微信 button 自带固定宽度，不清掉的话 flex 收不窄 */
  width: auto !important;
  margin: 0 !important;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  white-space: nowrap;
}

.safe-space {
  height: 160rpx;
}
