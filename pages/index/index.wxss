.hero {
  position: relative;
  background: linear-gradient(160deg, rgba(253, 243, 245, 0.82) 0%, rgba(251, 239, 242, 0.7) 55%, rgba(245, 237, 246, 0.66) 100%);
  padding: 60rpx 36rpx 56rpx;
  text-align: center;
}

.hero-text {
  padding: 0;
}

/* 店招：居中、放大、重点突出 */
.hero-name {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  text-align: center;
  line-height: 1.35;
}

/* 招牌下的小字 */
.hero-slogan {
  color: var(--accent-deep);
  margin: 12rpx 0 0;
  font-size: 34rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

/* 关于小铺：纸条风须知卡 */
.notice {
  position: relative;
  margin-top: 24rpx;
  background: rgba(253, 244, 240, 0.93);
  padding: 40rpx 36rpx 32rpx;
}

/* 莫兰迪浅紫“胶带”装饰 */
.notice-tape {
  position: absolute;
  top: -14rpx;
  left: 50%;
  width: 180rpx;
  height: 44rpx;
  margin-left: -90rpx;
  background: rgba(181, 161, 198, 0.55);
  transform: rotate(-2deg);
  border-radius: 6rpx;
}

.notice-title {
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 6rpx;
}

.notice-item {
  font-size: 28rpx;
  color: var(--ink);
  padding: 6rpx 0;
  letter-spacing: 1rpx;
  line-height: 1.68;
}

.notice-end {
  margin-top: 26rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--purple-deep);
  letter-spacing: 5rpx;
  line-height: 1.5;
}

.notice-end-line {
  display: block;
}

.steps {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 10rpx;
}

.step {
  flex: 1;
  text-align: center;
  padding: 0 4rpx;
}

.step-icon {
  font-size: 44rpx;
  color: var(--purple);
  font-weight: 700;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
}

.step-desc {
  font-size: 21rpx;
  color: var(--sub);
  line-height: 1.45;
  padding: 0 2rpx;
}

.feat-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.feat-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.feat-info {
  flex: 1;
  padding: 24rpx 28rpx;
}

.feat-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

/* 简介：比名字小一号，行距松开，颜色压淡，看起来更精致 */
.feat-desc {
  font-size: 22rpx;
  color: var(--sub);
  line-height: 1.66;
  letter-spacing: 0.6rpx;
  margin-bottom: 16rpx;
}

.feat-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.days {
  color: var(--sub);
  font-size: 24rpx;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--sub);
}

.more-btn {
  width: 100%;
  margin-top: 8rpx;
}

.about-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
  padding: 36rpx 0 12rpx;
  letter-spacing: 1rpx;
}

.promise-card {
  padding: 32rpx 36rpx;
}

.promise {
  font-size: 28rpx;
  color: var(--ink);
  padding: 10rpx 0;
}

.promise-more {
  margin-top: 16rpx;
  color: var(--accent-deep);
  font-size: 28rpx;
}

/* 首页整页蕾丝背景（WXSS 不支持本地图片，故 base64 内嵌；源文件 assets/lace-bg.jpg） */
.lace-page {
  min-height: 100vh;
  /* 让出底部导航的高度，「了解小店的故事」不被盖住 */
  padding-bottom: var(--tabbar-h);
  box-sizing: border-box;
  background-color: #FBF3F4;
  background-image: url('data:image/jpeg;base64,');
  background-repeat: repeat;
  background-size: 420rpx 420rpx;
}
