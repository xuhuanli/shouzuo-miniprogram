.cart-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 8rpx 20rpx;
}

.cart-count {
  font-size: 25rpx;
  color: var(--sub);
}

.cart-manage {
  font-size: 27rpx;
  color: var(--accent-deep);
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.ck {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 2rpx solid #DFC2CB;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.ck.on {
  background: var(--accent);
  border-color: var(--accent);
}

.ci-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.ci-main {
  flex: 1;
  min-width: 0;
}

.ci-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ci-spec {
  font-size: 22rpx;
  color: var(--sub);
  line-height: 1.5;
  margin-bottom: 14rpx;
}

.ci-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ci-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-deep);
}

.qty {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 46rpx;
  height: 46rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
}

.qty-num {
  width: 62rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 27rpx;
}

/* 管理模式的删除角标：贴在卡片右上角的浅粉小角（卡片圆角 + overflow:hidden 正好把外侧两角收圆），
   × 用两根圆头短线画，和详情页的乘号、加减号是一套 */
.ci-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 64rpx;
  height: 56rpx;
  border-bottom-left-radius: 24rpx;
  background: var(--accent-soft);
  transition: background 0.15s ease;
}

.ci-del::before,
.ci-del::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -11rpx;
  border-radius: 2rpx;
  background: var(--accent-deep);
  transition: transform 0.2s ease;
}

.ci-del::before {
  transform: rotate(45deg);
}

.ci-del::after {
  transform: rotate(-45deg);
}

/* 按下：底色加深一点，× 转一下 */
.ci-del-press {
  background: #F6D3DC;
}

.ci-del-press::before {
  transform: rotate(135deg);
}

.ci-del-press::after {
  transform: rotate(45deg);
}

.cart-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--sub);
  margin: 20rpx 0 10rpx;
  line-height: 1.6;
}

/* 结算条紧贴在底部导航上沿（--tabbar-h 已含安全区），
   上下留一样的空隙，不留一道白边；底色用莫兰迪豆沙粉，和奶黄导航区分开 */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--tabbar-h);
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #EBD7D9;
  border-top: 1rpx solid #E0C7CA;
}

.bar-all {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: #8C7360;
  flex-shrink: 0;
}

.bar-all .ck {
  margin-right: 10rpx;
}

.bar-sum {
  flex: 1;
  text-align: right;
  padding-right: 20rpx;
}

.bar-sum-k {
  font-size: 23rpx;
  color: #8C7360;
  margin-right: 8rpx;
}

.bar-sum-v {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--accent-deep);
}

/* 确定预约：宽度收到刚好够字，高度舒服不臃肿 */
.bar-go {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 208rpx;
  height: 68rpx;
  line-height: 1;
  padding: 0;
  box-sizing: border-box;
  margin: 0;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 比豆沙粉底色深一档，按钮才立得出来 */
.bar-ok {
  background: var(--accent-deep);
}

/* 空购物车里的按钮别拉满整行 */
.empty-btn {
  margin-top: 40rpx;
  width: 320rpx;
}

.bar-go.del {
  color: #B06B7E;
  border-color: #EFC3CD;
}

.safe-space {
  height: calc(140rpx + var(--tabbar-h));
}
