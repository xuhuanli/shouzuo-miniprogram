page {
  background: #000;
}

.pv {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #000;
}

.pv-swiper,
.pv-area,
.pv-view,
.pv-img {
  width: 100%;
  height: 100%;
}

.pv-top {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  height: 44px;
  padding-left: 24rpx;
  box-sizing: content-box;
  pointer-events: none;
}

/* 关闭：半透明圆底 + 两根短线画的 ×，和小程序里其他 × 一套 */
.pv-close {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  pointer-events: auto;
  transition: background 0.15s ease;
}

.pv-close::before,
.pv-close::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -13rpx;
  border-radius: 2rpx;
  background: #fff;
}

.pv-close::before {
  transform: rotate(45deg);
}

.pv-close::after {
  transform: rotate(-45deg);
}

.pv-close-press {
  background: rgba(255, 255, 255, 0.3);
}

.pv-count {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

.pv-hint {
  position: absolute;
  left: 50%;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(236, 143, 165, 0.85);
  color: #fff;
  font-size: 24rpx;
  white-space: nowrap;
  pointer-events: none;
  transition: opacity 0.6s ease;
}

.pv-hint.hide {
  opacity: 0;
}
