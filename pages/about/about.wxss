.story-card {
  margin-top: 8rpx;
}

.story-img {
  width: 100%;
  height: 420rpx;
  display: block;
}

.story-text {
  padding: 32rpx 36rpx 40rpx;
}

.story-title {
  font-size: 37rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.story-body {
  font-size: 28rpx;
  color: #6B6357;
}

.proc-card {
  padding: 20rpx 36rpx;
}

.proc {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.proc:last-child {
  border-bottom: none;
}

.proc-t {
  font-size: 31rpx;
  font-weight: 600;
}

.proc-d {
  font-size: 26rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

.contact-card {
  padding: 12rpx 36rpx;
}

.c-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}

.c-row:last-child {
  border-bottom: none;
}

.c-k {
  width: 140rpx;
  color: var(--sub);
  flex-shrink: 0;
}

.c-v {
  flex: 1;
}

.c-copy {
  color: var(--accent);
  font-size: 26rpx;
}

.foot-note {
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 36rpx;
}

.admin-entry {
  text-align: center;
  font-size: 22rpx;
  color: #C9B0B6;
  padding: 44rpx 0 10rpx;
  letter-spacing: 2rpx;
}
