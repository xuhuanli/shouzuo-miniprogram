/* 下内边距别再压小：卡片是 overflow:hidden，按钮离下边缘太近，真机上下边框会被裁到 */
.order {
  padding: 32rpx 36rpx 28rpx;
  margin-bottom: 28rpx;
}

.o-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.o-no {
  font-size: 24rpx;
  color: var(--sub);
  letter-spacing: 1rpx;
}

.o-status {
  font-size: 24rpx;
  color: var(--purple-deep);
  background: var(--purple-soft);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.o-status.off {
  color: var(--sub);
  background: var(--bg);
}

.o-status.ship {
  color: #b4617a;
  background: var(--accent-soft);
}

/* 物流信息块 */
.o-track {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--purple-soft);
  border-radius: 16rpx;
}

.o-track-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.o-track-t {
  font-size: 22rpx;
  color: var(--purple-deep);
}

.o-track-copy {
  font-size: 22rpx;
  color: var(--accent-deep);
}

.o-track-body {
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

/* 一张单里的每件作品：小图 + 名字 × 数量 + 材质面料，件与件之间虚线隔开 */
.o-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px dashed var(--line);
}

.o-img {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
}

.o-item-main {
  flex: 1;
  min-width: 0;
}

.o-item-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.o-style {
  font-size: 31rpx;
  font-weight: 600;
}

.o-qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--sub);
}

/* 整单费用：件数 · 加急 · 运费 · 参考价 */
.o-fee {
  margin-top: 14rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-deep);
}

.o-line {
  font-size: 26rpx;
  color: #6B6357;
  padding: 4rpx 0;
}

.o-imgs {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.o-imgs image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

/* 操作按钮：用 view 做点击块（微信 button 自带默认宽度会被拉宽、整排往左溢出），
   只占字的宽度，贴右下角，离卡片下边缘只留一点空 */
.o-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.o-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  max-width: 100%;
  height: 52rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 23rpx;
  line-height: 1;
  white-space: nowrap;
  color: var(--accent-deep);
  background: transparent;
  /* 用 1px 不用 1rpx：1rpx 在真机上不足 1 个物理像素，按钮下边框会被吃掉、看着像被裁了 */
  border: 1px solid var(--accent);
  border-radius: 999rpx;
}

.o-btn.del {
  color: #B06B7E;
  border-color: #EFC3CD;
}

/* 页面底部：说明文字 + 关于小店入口，钉在底部导航栏正上方 */
.o-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--tabbar-h);
  z-index: 20;
  padding: 14rpx 32rpx;
  background: rgba(251, 243, 244, 0.96);
  border-top: 1rpx solid var(--line);
}

.tip {
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--sub);
  margin-bottom: 10rpx;
}

.empty-btn {
  margin-top: 40rpx;
  width: 320rpx;
}

.about-entry {
  text-align: center;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--accent-deep);
}

/* 给钉在底部的说明条让出位置，最后一张订单不会被盖住 */
.page-pad {
  padding-bottom: calc(190rpx + var(--tabbar-h));
}
